{
  "packet_id": "pydantic-pypi-2.0.0",
  "package": "pydantic",
  "ecosystem": "pypi",
  "from_version": "*",
  "to_version": "2.0.0",
  "sources": [
    {
      "url": "https://docs.pydantic.dev/2.0/migration/",
      "kind": "docs"
    }
  ],
  "notes": "Based on the Pydantic v2 migration guide. Mechanical rewrites cover the common BaseModel method renames, validator decorator/import renames, and field attribute renames. Config migration and raw/file parsing changes require manual review. `BaseSettings` moved to the separate `pydantic-settings` package.",
  "side_effects": [
    {
      "kind": "config",
      "detail": "Inner `Config` classes and many config keys move to `model_config = ConfigDict(...)`; renamed or removed options need manual review."
    },
    {
      "kind": "other",
      "detail": "`parse_raw()` / `parse_file()` and other multi-step parsing flows are not safe one-step rewrites because v2 separates input loading from validation and changes supported options."
    },
    {
      "kind": "other",
      "detail": "Projects using `BaseSettings` need the separate `pydantic-settings` dependency in addition to the import-path update."
    }
  ],
  "rules": [
    {
      "type": "DEPENDENCY_BUMP",
      "package": "pydantic",
      "from_version": "*",
      "to_version": "2.0.0",
      "ecosystems": [
        "pip",
        "pyproject"
      ],
      "reason": "Pin pydantic to target version 2.0.0"
    },
    {
      "type": "AST_IMPORT_REWRITE",
      "target_files": [
        "*.py"
      ],
      "old_import": "from pydantic import BaseSettings",
      "new_import": "from pydantic_settings import BaseSettings"
    },
    {
      "type": "AST_IMPORT_REWRITE",
      "target_files": [
        "*.py"
      ],
      "old_import": "from pydantic import validator",
      "new_import": "from pydantic import field_validator"
    },
    {
      "type": "AST_IMPORT_REWRITE",
      "target_files": [
        "*.py"
      ],
      "old_import": "from pydantic import root_validator",
      "new_import": "from pydantic import model_validator"
    },
    {
      "type": "AST_IMPORT_REWRITE",
      "target_files": [
        "*.py"
      ],
      "old_import": "from pydantic import validate_arguments",
      "new_import": "from pydantic import validate_call"
    },
    {
      "type": "AST_CALL_REWRITE",
      "target_files": [
        "*.py"
      ],
      "old_callee": "dict",
      "new_callee": "model_dump",
      "surface": {
        "export_path": [
          "dict"
        ],
        "spellings": [
          "qualified",
          "imported"
        ],
        "use_kinds": [
          "call",
          "decorator"
        ]
      }
    },
    {
      "type": "AST_CALL_REWRITE",
      "target_files": [
        "*.py"
      ],
      "old_callee": "json",
      "new_callee": "model_dump_json",
