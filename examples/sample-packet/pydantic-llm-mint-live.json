  "side_effects": [
    {
      "kind": "config",
      "detail": "Manual config migration is required for `class Config` -> `model_config = ConfigDict(...)`; this packet does not collapse nested config classes or rename every legacy config key."
    },
    {
      "kind": "config",
      "detail": "Any `BaseModel.from_orm` usage also needs `from_attributes=True` (the v1 `orm_mode` rename) for equivalent behavior after the call rewrite."
    },
    {
      "kind": "config",
      "detail": "Nested Config classes must be converted to model_config assignments; the migration guide documents key renames such as allow_population_by_field_name\u2192populate_by_name, orm_mode\u2192from_attributes, schema_extra\u2192json_schema_extra, validate_all\u2192validate_default, and anystr_*\u2192str_*. Some settings are removed or change semantics (for example allow_mutation\u2192frozen) and need manual review. https://docs.pydantic.dev/2.0/migration/"
    },
    {
      "kind": "other",
      "detail": "BaseSettings now comes from the separate pydantic-settings package, and some migrations need manual refactors instead of a straight rewrite (for example __root__ models to RootModel, parse_file, schema_json, and parse_obj_as). https://docs.pydantic.dev/2.0/migration/"
    }
  ]
