{
  "packet_id": "pydantic-1.10.13-2.0.0",
  "package": "pydantic",
  "ecosystem": "pypi",
  "from_version": "1.10.13",
  "to_version": "2.0.0",
  "sources": [
    {
      "url": "https://docs.pydantic.dev/2.0/migration/",
      "kind": "docs"
    }
  ],
  "notes": "Frozen harness smoke for Watch-visible validator hop + declaration rewrites + BaseModel.dict CALL. AST_DECLARATION_REWRITE renames import members, collapses inner Config, and ensures @classmethod on field_validator. AST_CALL_REWRITE covers @validator and BaseModel.dict. Hand-authored; not LLM packet new.",
  "side_effects": [
    {
      "kind": "other",
      "detail": "v1 validator kwargs (pre/always/each_item) have no evidence-backed map onto field_validator mode=.",
      "gap_kind": "multi_step",
      "old_shape": "@validator(..., pre=True|always=True|each_item=True)",
      "new_shape": "@field_validator(..., mode='before'|'after'|'wrap'|'plain')",
      "blocker": "mode= mapping is not derived from surface {id,kind}; detector refuses unknown kwargs until a recipe mapping lands",
      "evidence_url": "https://docs.pydantic.dev/2.0/migration/"
    }
  ],
  "rules": [
    {
      "type": "DEPENDENCY_BUMP",
      "package": "pydantic",
      "from_version": "1.10.13",
      "to_version": "2.0.0",
      "ecosystems": ["pip", "pyproject"],
      "reason": "Pin the consumer at pydantic 2.0.0 for the validator hop smoke."
    },
    {
      "type": "AST_DECLARATION_REWRITE",
      "target_files": ["*.py"],
      "operation": {
        "kind": "import_member",
        "source": {"module": "pydantic", "name": "validator"},
        "target": {"module": "pydantic", "name": "field_validator"},
        "local_binding": "preserve"
      },
      "reason": "Rename validator inside multi-name from-imports without clause fragments."
    },
    {
      "type": "AST_DECLARATION_REWRITE",
      "target_files": ["*.py"],
      "operation": {
        "kind": "inner_class_to_assignment",
        "selector": {
          "inner_name": "Config",
          "parent_bases_any": ["BaseModel"]
        },
        "keys": {
          "orm_mode": "from_attributes"
        },
        "emit": {
          "target": "model_config",
          "constructor": "ConfigDict",
          "ensure_import": {"module": "pydantic", "name": "ConfigDict"}
        },
        "unmapped_assignments": "refuse",
        "unsupported_members": "refuse"
      },
      "reason": "Inner Config with mapped keys becomes model_config = ConfigDict(...)."
    },
    {
      "type": "AST_DECLARATION_REWRITE",
      "target_files": ["*.py"],
      "operation": {
        "kind": "ensure_classmethod",
        "decorator": "field_validator"
      },
      "reason": "field_validator decorated methods must be classmethods."
    },
    {
      "type": "AST_DECLARATION_REWRITE",
      "target_files": ["*.py"],
      "operation": {
        "kind": "decorated_def_convention",
        "decorator": "field_validator",
        "context": null,
        "options": [],
        "unmappable_params": [],
        "unknown_params": "refuse",
        "unknown_options": "refuse"
      },
      "reason": "v2 field_validator takes (cls, value). Anything else is a located gap."
    },
    {
      "type": "AST_DECLARATION_REWRITE",
      "target_files": ["*.py"],
      "operation": {
        "kind": "decorated_def_convention",
        "decorator": "model_validator",
        "context": null,
        "options": [],
        "unmappable_params": [],
        "unknown_params": "refuse",
        "unknown_options": "refuse"
      },
      "reason": "v2 model_validator takes (cls, value). Anything else is a located gap."
    },
    {
      "type": "AST_CALL_REWRITE",
      "target_files": ["*.py"],
      "old_callee": "BaseModel.dict",
      "new_callee": "BaseModel.model_dump",
      "reason": "BaseModel.dict() → model_dump(); instance .dict() without receiver bind stays Watch-visible residual."
    },
    {
      "type": "AST_CALL_REWRITE",
      "target_files": ["*.py"],
      "old_callee": "validator",
      "new_callee": "field_validator",
      "reason": "@validator(...) becomes @field_validator(...). Watch leftovers key on this old_callee."
    }
  ]
}
