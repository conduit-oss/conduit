      }
    },
    {
      "type": "AST_ATTR_RENAME",
      "target_files": [
        "*.py"
      ],
      "old_attr": "__fields__",
      "new_attr": "model_fields"
    },
    {
      "type": "AST_ATTR_RENAME",
      "target_files": [
        "*.py"
      ],
      "old_attr": "__fields_set__",
      "new_attr": "model_fields_set"
    },
    {
      "type": "AST_ATTR_RENAME",
      "target_files": [
        "*.py"
      ],
      "old_attr": "__config__",
      "new_attr": "model_config"
    },
    {
      "type": "AST_PARAM_RENAME",
      "target_files": [
        "*.py"
      ],
      "function_target": "pydantic.Field",
      "old_param": "regex",
      "new_param": "pattern"
    },
    {
      "type": "AST_PARAM_RENAME",
      "target_files": [
        "*.py"
      ],
      "function_target": "pydantic.Field",
      "old_param": "min_items",
      "new_param": "min_length"
    },
    {
      "type": "AST_PARAM_RENAME",
      "target_files": [
        "*.py"
      ],
      "function_target": "pydantic.Field",
      "old_param": "max_items",
      "new_param": "max_length"
    },
    {
      "type": "AST_IMPORT_REWRITE",
      "target_files": [
        "*.py"
      ],
      "old_import": "from pydantic import BaseSettings",
      "new_import": "from pydantic_settings import BaseSettings"
    },
    {
      "type": "AST_IMPORT_REWRITE",
      "target_files": [
        "*.py"
      ],
      "old_import": "BaseModel, validator",
      "new_import": "BaseModel, field_validator, ConfigDict",
      "reason": "Rewrite the from-import clause only (P5 hop fragment). Avoid bare validator so a second apply cannot re-prefix field_validator. Pull ConfigDict in the same clause for the Config rewrite."
    },
    {
      "type": "AST_CALL_REWRITE",
      "target_files": [
        "*.py"
      ],
      "old_callee": "validator",
      "new_callee": "field_validator",
      "reason": "@validator(...) becomes @field_validator(...). Watch leftovers key on this old_callee. Surface floor makes the decorator proof-eligible.",
      "surface": {
        "export_path": [
          "validator"
        ],
        "spellings": [
          "qualified",
          "imported"
        ],
        "use_kinds": [
          "call",
          "decorator"
        ]
      }
    },
    {
      "type": "EXACT_STRING_REPLACE",
      "target_files": [
        "*.py"
      ],
      "match": "    class Config:\n        orm_mode = True",
      "replace": "    model_config = ConfigDict(from_attributes=True)",
      "reason": "Inner class Config / orm_mode -> v2 model_config = ConfigDict(from_attributes=True). Schema EXACT_STRING_REPLACE; no apply engine branch."
    }
  ]
}
