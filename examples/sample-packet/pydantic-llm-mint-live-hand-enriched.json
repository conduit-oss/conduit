{
  "packet_id": "pydantic-pypi-2.0.0-hand-enriched",
  "package": "pydantic",
  "ecosystem": "pypi",
  "from_version": "*",
  "to_version": "2.0.0",
  "sources": [
    {
      "url": "https://docs.pydantic.dev/2.0/migration/",
      "kind": "docs"
    }
  ],
  "notes": "HAND enrichment of the frozen LLM mint at pydantic-llm-mint-live.json. Adds missing rule families so the pydantic-validator-fixture @validator decorator and inner class Config / orm_mode are in-scope. Validator hop copies P5 (AST_IMPORT_REWRITE clause fragment BaseModel, validator plus AST_CALL_REWRITE validator -> field_validator with a proof-eligible surface floor). Config uses schema EXACT_STRING_REPLACE to model_config = ConfigDict(from_attributes=True); no apply/Watch vendor branches. Keep live BaseModel renames and surface metadata. Not LLM packet new; Amin remints with keys separately. Live mint checksum is unchanged.",
  "side_effects": [
    {
      "kind": "config",
      "detail": "Fixture-shaped inner `class Config: orm_mode = True` is rewritten by EXACT_STRING_REPLACE to `model_config = ConfigDict(from_attributes=True)` plus the import-clause ConfigDict add. Other Config layouts still need hand conversion."
    },
    {
      "kind": "other",
      "detail": "`parse_raw()` / `parse_file()` / `schema_json()` are not universally safe single-step rewrites because file IO, content-type handling, and JSON-string wrapping may need manual refactoring."
    },
    {
      "kind": "other",
      "detail": "`BaseSettings` moved to the separate `pydantic-settings` package; projects need to add that dependency when applying the import rewrite."
    },
    {
      "kind": "other",
      "detail": "field_validator often needs @classmethod and signature or mode= reshape; not expressed by AST_CALL_REWRITE."
    }
  ],
  "rules": [
    {
      "type": "DEPENDENCY_BUMP",
      "package": "pydantic",
      "from_version": "*",
      "to_version": "2.0.0",
      "ecosystems": [
        "pip",
        "pyproject"
      ],
      "reason": "Pin pydantic to 2.0.0"
    },
    {
      "type": "AST_CALL_REWRITE",
      "target_files": [
        "*.py"
      ],
      "old_callee": "BaseModel.dict",
      "new_callee": "BaseModel.model_dump",
      "surface": {
        "export_path": [
          "BaseModel",
          "dict"
        ],
        "spellings": [
          "qualified",
          "imported",
          "receiver_member"
        ],
        "use_kinds": [
          "call",
          "decorator"
        ]
      }
    },
    {
      "type": "AST_CALL_REWRITE",
      "target_files": [
        "*.py"
      ],
      "old_callee": "BaseModel.json",
      "new_callee": "BaseModel.model_dump_json",
      "surface": {
        "export_path": [
          "BaseModel",
          "json"
        ],
        "spellings": [
          "qualified",
          "imported",
          "receiver_member"
        ],
        "use_kinds": [
          "call",
          "decorator"
        ]
      }
    },
    {
