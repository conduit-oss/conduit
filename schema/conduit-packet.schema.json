{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xlor1009/conduit/main/schema/conduit-packet.schema.json",
  "title": "ConduitMigrationPacket",
  "description": "Migration Packet: AST/string codemod rules for a package version jump.",
  "type": "object",
  "required": ["packet_id", "package", "ecosystem", "from_version", "to_version", "rules"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "packet_id": { "type": "string", "minLength": 1 },
    "package": { "type": "string", "minLength": 1 },
    "ecosystem": {
      "type": "string",
      "enum": ["pypi", "npm", "go", "maven", "other"]
    },
    "from_version": { "type": "string" },
    "to_version": { "type": "string" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "kind"],
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["github_release", "changelog", "docs", "openapi", "other"]
          }
        }
      }
    },
    "notes": { "type": ["string", "null"] },
    "side_effects": {
      "type": "array",
      "description": "Human checklist for webhooks, databases, and other non-code ripples.",
      "items": {
        "type": "object",
        "required": ["kind", "detail"],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["webhook", "database", "config", "other"]
          },
          "detail": { "type": "string", "minLength": 1 }
        }
      }
    },
    "ignore": {
      "type": "object",
      "additionalProperties": false,
      "description": "Paths/globs/patterns heuristics and LLMs must not rewrite (contract oracles).",
      "properties": {
        "globs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "patterns": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "rule": {
      "oneOf": [
        { "$ref": "#/$defs/exact_string_replace" },
        { "$ref": "#/$defs/regex_replace" },
        { "$ref": "#/$defs/ast_param_rename" },
        { "$ref": "#/$defs/dependency_bump" },
        { "$ref": "#/$defs/dependency_add" },
        { "$ref": "#/$defs/dependency_remove" },
        { "$ref": "#/$defs/ast_import_rewrite" },
        { "$ref": "#/$defs/ast_attr_rename" },
        { "$ref": "#/$defs/ast_call_rewrite" },
        { "$ref": "#/$defs/key_rename" }
      ]
    },
    "rule_reason": {
      "type": "string",
      "description": "Human-readable rationale for why this rule was chosen (shown in PR body)."
    },
    "exact_string_replace": {
      "type": "object",
      "required": ["type", "target_files", "match", "replace"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "EXACT_STRING_REPLACE" },
        "target_files": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "match": { "type": "string" },
        "replace": { "type": "string" },
        "reason": { "$ref": "#/$defs/rule_reason" }
      }
    },
    "regex_replace": {
      "type": "object",
      "required": ["type", "target_files", "pattern", "replace"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "REGEX_REPLACE" },
        "target_files": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "pattern": { "type": "string" },
        "replace": { "type": "string" },
        "reason": { "$ref": "#/$defs/rule_reason" }
      }
    },
    "ast_param_rename": {
      "type": "object",
      "required": [
        "type",
        "target_files",
        "function_target",
        "old_param",
        "new_param"
      ],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "AST_PARAM_RENAME" },
        "target_files": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "function_target": { "type": "string" },
        "old_param": { "type": "string" },
        "new_param": { "type": "string" },
        "reason": { "$ref": "#/$defs/rule_reason" }
      }
    },
    "dep_scope": {
      "type": "string",
      "enum": ["main", "dev", "peer"],
      "description": "main (default), dev extras/devDependencies, or npm peerDependencies."
    },
    "dep_ecosystems": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["pip", "npm", "pyproject", "go", "maven", "gradle"]
      }
    },
    "dependency_bump": {
      "type": "object",
      "required": ["type", "package", "from_version", "to_version"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "DEPENDENCY_BUMP" },
        "package": { "type": "string" },
        "from_version": { "type": "string" },
        "to_version": { "type": "string" },
        "ecosystems": { "$ref": "#/$defs/dep_ecosystems" },
        "scope": { "$ref": "#/$defs/dep_scope" },
        "reason": { "$ref": "#/$defs/rule_reason" }
      }
    },
    "dependency_add": {
      "type": "object",
      "required": ["type", "package", "to_version"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "DEPENDENCY_ADD" },
        "package": { "type": "string", "minLength": 1 },
        "to_version": { "type": "string", "minLength": 1 },
        "ecosystems": { "$ref": "#/$defs/dep_ecosystems" },
        "scope": { "$ref": "#/$defs/dep_scope" },
        "reason": { "$ref": "#/$defs/rule_reason" }
      }
    },
    "dependency_remove": {
      "type": "object",
      "required": ["type", "package"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "DEPENDENCY_REMOVE" },
        "package": { "type": "string", "minLength": 1 },
        "from_version": { "type": "string" },
        "ecosystems": { "$ref": "#/$defs/dep_ecosystems" },
        "scope": { "$ref": "#/$defs/dep_scope" },
        "reason": { "$ref": "#/$defs/rule_reason" }
      }
    },
    "ast_import_rewrite": {
      "type": "object",
      "required": ["type", "target_files", "old_import", "new_import"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "AST_IMPORT_REWRITE" },
        "target_files": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "old_import": { "type": "string" },
        "new_import": { "type": "string" },
        "reason": { "$ref": "#/$defs/rule_reason" }
      }
    },
    "ast_attr_rename": {
      "type": "object",
      "required": ["type", "target_files", "old_attr", "new_attr"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "AST_ATTR_RENAME" },
        "target_files": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "old_attr": { "type": "string" },
        "new_attr": { "type": "string" },
        "reason": { "$ref": "#/$defs/rule_reason" }
      }
    },
    "ast_call_rewrite": {
      "type": "object",
      "required": ["type", "target_files", "old_callee", "new_callee"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "AST_CALL_REWRITE" },
        "target_files": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "old_callee": { "type": "string" },
        "new_callee": { "type": "string" },
        "reason": { "$ref": "#/$defs/rule_reason" }
      }
    },
    "key_rename": {
      "type": "object",
      "required": ["type", "target_files", "old_key", "new_key"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "KEY_RENAME" },
        "target_files": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "old_key": { "type": "string", "minLength": 1 },
        "new_key": { "type": "string", "minLength": 1 },
        "reason": { "$ref": "#/$defs/rule_reason" }
      }
    }
  }
}
