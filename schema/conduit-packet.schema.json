{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/conduit-oss/conduit/main/schema/conduit-packet.schema.json",
  "title": "ConduitMigrationPacket",
  "description": "Migration Packet: AST/string codemod rules for a package version jump.",
  "type": "object",
  "required": ["packet_id", "package", "ecosystem", "from_version", "to_version", "rules"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "packet_id": { "type": "string", "minLength": 1 },
    "package": { "type": "string", "minLength": 1 },
    "ecosystem": {
      "type": "string",
      "enum": ["pypi", "npm", "go", "maven", "other"]
    },
    "from_version": { "type": "string" },
    "to_version": { "type": "string" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "kind"],
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["github_release", "changelog", "docs", "openapi", "other"]
          }
        }
      }
    },
    "notes": { "type": ["string", "null"] },
    "anticheat": {
      "type": "object",
      "description": "Optional packet-local anti-cheat extras (deny_substrings, banned_kwargs_on).",
      "additionalProperties": true
    },
    "side_effects": {
      "type": "array",
      "description": "Gaps current rule ops cannot express (webhooks, multi-step hops, uncodable). Legacy rows are {kind, detail} only.",
      "items": {
        "type": "object",
        "required": ["kind", "detail"],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["webhook", "database", "config", "other"]
          },
          "detail": { "type": "string", "minLength": 1 },
          "gap_kind": {
            "type": "string",
            "description": "Why this is not a rule.",
            "enum": ["multi_step", "uncodable", "external", "signature", "other"]
          },
          "old_shape": {
            "type": "string",
            "description": "Source shape left after apply (prose or token)."
          },
          "new_shape": {
            "type": "string",
            "description": "Intended successor shape when known."
          },
          "blocker": {
            "type": "string",
            "description": "Why current declaration/call ops cannot encode this hop."
          },
          "evidence_url": {
            "type": "string",
            "description": "Migration guide or changelog URL grounding the gap."
          }
        }
      }
    },
    "ignore": {
      "type": "object",
      "additionalProperties": false,
      "description": "Paths/globs/patterns heuristics and LLMs must not rewrite (contract oracles).",
      "properties": {
        "globs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "patterns": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "runtime_model_aliases": {
      "type": "object",
      "description": "Map packet fake or legacy model ids to live API models at runtime.",
      "additionalProperties": { "type": "string" }
    },
    "live_test": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alias_prefixes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "default_completion_model": {
          "type": "string",
          "description": "Fallback instruct/completion model for aliased ids."
        }
      }
    },
    "post_rules": {
      "type": "array",
      "description": "Body/wrapper fixes applied after SDK and REST rule stages.",
      "items": { "$ref": "#/$defs/post_rule" }
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "rule": {
      "oneOf": [
        { "$ref": "#/$defs/exact_string_replace" },
        { "$ref": "#/$defs/regex_replace" },
        { "$ref": "#/$defs/ast_param_rename" },
        { "$ref": "#/$defs/ast_param_drop" },
        { "$ref": "#/$defs/dependency_bump" },
        { "$ref": "#/$defs/dependency_add" },
        { "$ref": "#/$defs/dependency_remove" },
        { "$ref": "#/$defs/ast_import_rewrite" },
        { "$ref": "#/$defs/ast_declaration_rewrite" },
        { "$ref": "#/$defs/ast_attr_rename" },
        { "$ref": "#/$defs/ast_call_rewrite" },
        { "$ref": "#/$defs/key_rename" }
      ]
    },
    "rule_reason": {
      "type": "string",
      "description": "Human-readable rationale for why this rule was chosen (shown in PR body)."
    },
    "call_surface": {
      "type": "object",
      "required": ["export_path", "spellings", "use_kinds"],
      "additionalProperties": false,
      "properties": {
        "surface_id": { "type": "string", "minLength": 1 },
        "export_path": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "spellings": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["qualified", "imported", "receiver_member"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "use_kinds": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["call", "decorator"]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "exact_string_replace": {
      "type": "object",
      "required": ["type", "target_files", "match", "replace"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "EXACT_STRING_REPLACE" },
        "target_files": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "match": { "type": "string" },
        "replace": { "type": "string" },
        "reason": { "$ref": "#/$defs/rule_reason" }
      }
    },
    "regex_replace": {
      "type": "object",
      "required": ["type", "target_files", "pattern", "replace"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "REGEX_REPLACE" },
        "target_files": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "pattern": { "type": "string" },
        "replace": { "type": "string" },
        "reason": { "$ref": "#/$defs/rule_reason" }
      }
    },
    "ast_param_rename": {
      "type": "object",
      "required": [
        "type",
        "target_files",
        "function_target",
        "old_param",
        "new_param"
      ],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "AST_PARAM_RENAME" },
        "target_files": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "function_target": { "type": "string" },
        "old_param": { "type": "string" },
        "new_param": { "type": "string" },
        "reason": { "$ref": "#/$defs/rule_reason" }
      }
    },
    "ast_param_drop": {
      "type": "object",
      "required": ["type", "target_files", "function_target", "param"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "AST_PARAM_DROP" },
        "target_files": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "function_target": { "type": "string" },
        "param": { "type": "string" },
        "values": {
          "type": "array",
          "items": {}
        },
        "reason": { "$ref": "#/$defs/rule_reason" }
      }
    },
    "dep_scope": {
      "type": "string",
      "enum": ["main", "dev", "peer"],
      "description": "main (default), dev extras/devDependencies, or npm peerDependencies."
    },
    "dep_ecosystems": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["pip", "npm", "pyproject", "go", "maven", "gradle"]
      }
    },
    "dependency_bump": {
      "type": "object",
      "required": ["type", "package", "from_version", "to_version"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "DEPENDENCY_BUMP" },
        "package": { "type": "string" },
        "from_version": { "type": "string" },
        "to_version": { "type": "string" },
        "ecosystems": { "$ref": "#/$defs/dep_ecosystems" },
        "scope": { "$ref": "#/$defs/dep_scope" },
        "reason": { "$ref": "#/$defs/rule_reason" }
      }
    },
    "dependency_add": {
      "type": "object",
      "required": ["type", "package", "to_version"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "DEPENDENCY_ADD" },
        "package": { "type": "string", "minLength": 1 },
        "to_version": { "type": "string", "minLength": 1 },
        "ecosystems": { "$ref": "#/$defs/dep_ecosystems" },
        "scope": { "$ref": "#/$defs/dep_scope" },
        "reason": { "$ref": "#/$defs/rule_reason" }
      }
    },
    "dependency_remove": {
      "type": "object",
      "required": ["type", "package"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "DEPENDENCY_REMOVE" },
        "package": { "type": "string", "minLength": 1 },
        "from_version": { "type": "string" },
        "ecosystems": { "$ref": "#/$defs/dep_ecosystems" },
        "scope": { "$ref": "#/$defs/dep_scope" },
        "reason": { "$ref": "#/$defs/rule_reason" }
      }
    },
    "ast_import_rewrite": {
      "type": "object",
      "required": ["type", "target_files", "old_import", "new_import"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "AST_IMPORT_REWRITE" },
        "target_files": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "old_import": { "type": "string" },
        "new_import": { "type": "string" },
        "reason": { "$ref": "#/$defs/rule_reason" }
      }
    },
    "symbol_ref": {
      "type": "object",
      "required": ["module", "name"],
      "additionalProperties": false,
      "properties": {
        "module": { "type": "string", "minLength": 1 },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_]\\w*$"
        }
      }
    },
    "ast_declaration_rewrite": {
      "type": "object",
      "required": ["type", "target_files", "operation"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "AST_DECLARATION_REWRITE" },
        "target_files": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "operation": {
          "oneOf": [
            { "$ref": "#/$defs/import_member_operation" },
            { "$ref": "#/$defs/inner_class_to_assignment_operation" },
            { "$ref": "#/$defs/ensure_classmethod_operation" }
          ]
        },
        "reason": { "$ref": "#/$defs/rule_reason" }
      }
    },
    "ensure_classmethod_operation": {
      "type": "object",
      "required": ["kind", "decorator"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "ensure_classmethod" },
        "decorator": {
          "type": "string",
          "minLength": 1,
          "description": "Decorator name (leaf or dotted) whose defs must also carry @classmethod."
        }
      }
    },
    "import_member_operation": {
      "type": "object",
      "required": ["kind", "source", "target", "local_binding"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "import_member" },
        "source": { "$ref": "#/$defs/symbol_ref" },
        "target": { "$ref": "#/$defs/symbol_ref" },
        "local_binding": { "const": "preserve" }
      }
    },
    "inner_class_selector": {
      "type": "object",
      "required": ["inner_name"],
      "additionalProperties": false,
      "properties": {
        "inner_name": {
          "type": "string",
          "pattern": "^[A-Za-z_]\\w*$"
        },
        "parent_bases_any": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "assignment_emission": {
      "type": "object",
      "required": ["target", "constructor"],
      "additionalProperties": false,
      "properties": {
        "target": {
          "type": "string",
          "pattern": "^[A-Za-z_]\\w*$"
        },
        "constructor": { "type": "string", "minLength": 1 },
        "ensure_import": { "$ref": "#/$defs/symbol_ref" }
      }
    },
    "inner_class_to_assignment_operation": {
      "type": "object",
      "required": [
        "kind",
        "selector",
        "keys",
        "emit",
        "unmapped_assignments",
        "unsupported_members"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "inner_class_to_assignment" },
        "selector": { "$ref": "#/$defs/inner_class_selector" },
        "keys": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[A-Za-z_]\\w*$" },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z_]\\w*$"
          }
        },
        "emit": { "$ref": "#/$defs/assignment_emission" },
        "unmapped_assignments": { "enum": ["preserve", "refuse"] },
        "unsupported_members": { "const": "refuse" }
      }
    },
    "ast_attr_rename": {
      "type": "object",
      "required": ["type", "target_files", "old_attr", "new_attr"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "AST_ATTR_RENAME" },
        "target_files": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "old_attr": { "type": "string" },
        "new_attr": { "type": "string" },
        "reason": { "$ref": "#/$defs/rule_reason" }
      }
    },
    "ast_call_rewrite": {
      "type": "object",
      "required": ["type", "target_files", "old_callee", "new_callee"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "AST_CALL_REWRITE" },
        "target_files": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "old_callee": { "type": "string" },
        "new_callee": { "type": "string" },
        "reason": { "$ref": "#/$defs/rule_reason" },
        "surface": { "$ref": "#/$defs/call_surface" }
      }
    },
    "key_rename": {
      "type": "object",
      "required": ["type", "target_files", "old_key", "new_key"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "KEY_RENAME" },
        "target_files": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "old_key": { "type": "string", "minLength": 1 },
        "new_key": { "type": "string", "minLength": 1 },
        "reason": { "$ref": "#/$defs/rule_reason" }
      }
    },
    "post_rule": {
      "oneOf": [
        { "$ref": "#/$defs/wrapper_ensure_list" },
        { "$ref": "#/$defs/wrapper_ensure_dict_key" },
        { "$ref": "#/$defs/wrapper_delegate" },
        { "$ref": "#/$defs/function_body_replace" },
        { "$ref": "#/$defs/runtime_model_alias_rule" }
      ]
    },
    "wrapper_ensure_list": {
      "type": "object",
      "required": ["type", "target_files", "function_name"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "WRAPPER_ENSURE_LIST" },
        "target_files": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "function_name": { "type": "string", "minLength": 1 },
        "list_callee_hint": { "type": "string" },
        "reason": { "$ref": "#/$defs/rule_reason" },
        "source": { "type": "string" }
      }
    },
    "wrapper_ensure_dict_key": {
      "type": "object",
      "required": ["type", "target_files", "function_name", "required_key"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "WRAPPER_ENSURE_DICT_KEY" },
        "target_files": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "function_name": { "type": "string", "minLength": 1 },
        "required_key": { "type": "string", "minLength": 1 },
        "create_callee_hint": { "type": "string" },
        "reason": { "$ref": "#/$defs/rule_reason" },
        "source": { "type": "string" }
      }
    },
    "wrapper_delegate": {
      "type": "object",
      "required": ["type", "target_files", "function_name", "delegate_module", "delegate_symbol"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "WRAPPER_DELEGATE" },
        "target_files": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "function_name": { "type": "string", "minLength": 1 },
        "delegate_module": { "type": "string", "minLength": 1 },
        "delegate_symbol": { "type": "string", "minLength": 1 },
        "model_param": { "type": "string" },
        "reason": { "$ref": "#/$defs/rule_reason" },
        "source": { "type": "string" }
      }
    },
    "function_body_replace": {
      "type": "object",
      "required": ["type", "target_files", "function_name", "body"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "FUNCTION_BODY_REPLACE" },
        "target_files": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "function_name": { "type": "string", "minLength": 1 },
        "body": { "type": "string", "minLength": 1 },
        "replace_module": { "type": "boolean" },
        "reason": { "$ref": "#/$defs/rule_reason" },
        "source": { "type": "string" }
      }
    },
    "runtime_model_alias_rule": {
      "type": "object",
      "required": ["type", "target_files", "function_name"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "RUNTIME_MODEL_ALIAS" },
        "target_files": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "function_name": { "type": "string", "minLength": 1 },
        "default_model": { "type": "string" },
        "alias_prefixes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "replace_module": { "type": "boolean" },
        "reason": { "$ref": "#/$defs/rule_reason" },
        "source": { "type": "string" }
      }
    }
  }
}
